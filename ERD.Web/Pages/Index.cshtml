@page
@model Index
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h2 class="">Lista estrazioni</h2>
</div>

<div class="row mb-2">
    <div class="col-4">
        <select id="selGruppo" class="form-select">
            <option value="">- Qualsiasi Gruppo -</option>
            @foreach (var gp in this.Model.ListaGruppi)
            {
                <option value="@gp" selected="@(gp == this.Model.g)">@gp</option>
            }
        </select>
    </div>

    <div class="col-3">
        <input type="text" id="txtNome" class="form-control" placeholder="Filtra per nome" value="@Model.n" />
    </div>

    <div class="col-3 pt-2">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="chkSchedulati" checked="@(this.Model.s == "1")" />
            <label class="form-check-label fw-medium" for="Attivo">Solo schedulati</label>
        </div>
    </div>

</div>

<div class="row">
    <div class="col-12">
        <div class="card">

            <div class="table-responsive">
                <table class="table table-vcenter card-table table-striped">
                    <thead>
                        <tr>
                            <th>ID#</th>
                            <th>Nome</th>
                            <th>Gruppo</th>
                            <th>Num. Output</th>
                            <th>Invio Email</th>
                            <th>Schedulazione</th>
                            <th>Prossima esecuzione</th>
                            <th>Copia su Path</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>

                        @foreach (var item in this.Model.Lista)
                        {
                            <tr data-repo-id="@item.DataObj.Id">
                                <td>@item.DataObj.Id</td>
                                <td> <a asp-page="/Report/AddOrEdit" asp-route-Id="@item.DataObj.Id">@item.DataObj.Nome</a></td>
                                <td class="text-secondary">@item.DataObj.Gruppo</td>
                                <td class="text-secondary">@item.DataObj.NumOutputStorico</td>
                                <td class="text-secondary">@(item.IsPrevistoInvioMail ? "SI" : "NO")</td>

                                @if (!item.IsSchedulazioneAttiva)
                                {
                                    <td class="text-secondary text-center">NO</td>
                                }
                                else
                                {
                                    <td class="text-secondary text-center">
                                        SI
                                        <br />
                                        <span class="badge badge-sm bg-yellow text-yellow-fg">@item.DataObj.CronString</span>
                                    </td>
                                }

                                

                                <td class="text-secondary">@(item.IsSchedulazioneAttiva ? item.GetNextSchedule(DateTime.Now).ToString("dd/MM/yyyy HH:mm") : "")</td>
                                <td class="text-secondary">@(item.IsPrevistoCopyToPath ? "SI" : "NO")</td>
                                <td>
                                    <button class="btn btn-sm btn-primary ddd">Esegui</button>
                                </td>
                            </tr>
                        }

                        @if (!this.Model.Lista.Any())
                        {
                            <tr><td colspan="99" class="text-center">Nessuna estrazione presente</td></tr>
                        }

                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="99">
                                @await Html.PartialAsync("_DataPager", this.Model.Pager)
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

    </div>
</div>

@section Scripts {

    <script>
        $(function () {
            //Colorazione filtri impostati
            $("#selGruppo").toggleClass("bg-yellow-lt ", $("#selGruppo").val() != "");
            $("#selGruppo option").toggleClass("bg-yellow-lt", $("#selGruppo").val() != "");
            $("#txtNome").toggleClass("bg-yellow-lt", $("#txtNome").val() != '');

            $("#selGruppo").on("change", function () {
                const url = new URL(window.location.href);
                val = $("#selGruppo").val().trim();
                if (val == "")
                    url.searchParams.delete('g');
                else
                    url.searchParams.set('g', val);
                window.location.href = url.toString();
            });

            $("#chkSchedulati").on("change", function () {
                const url = new URL(window.location.href);

                val = $("#chkSchedulati:checked").length > 0 ? "1" : "";
                if (val == "")
                    url.searchParams.delete('s');
                else
                    url.searchParams.set('s', val);
                window.location.href = url.toString();
            });

            $("#txtNome").on("change", function () {
                const url = new URL(window.location.href);
                val = $("#txtNome").val().trim();
                if (val == "")
                    url.searchParams.delete('n');
                else
                    url.searchParams.set('n', val);
                window.location.href = url.toString();
            });

            $(".ddd").on("click", function () {
                
                 ajaxGetAsync("?handler=Esegui&id="+$(this).parents("tr").attr("data-repo-id"), null, function(data){
                    $("#modal-esegui").remove();
                    $("body").append(data);
                    $("#modal-esegui").modal({backdrop: false, keyboard: false}).modal("show");
                 });
            });

        });
    </script>

}