@using Business.Data.Objects.Common
@model ReportEstrazioneBIZ

<div class="modal fade" id="modal-esegui" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">ESEGUI -> @Model.DataObj.Nome</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row mb-3 align-items-end">
                    
                    <div class="col-auto">
                        <div class="form-label">Scegli l'azione</div>
                        <div>
                           
                            <label class="form-check">
                                <input id="radEseguiScarica" class="form-check-input" type="radio" name="radios" checked>
                                <span class="form-check-label">Esegui e scarica risultato</span>
                            </label>

                            <div class="ms-4">
                                <label class="form-check">
                                    <input id="chkEseguiSalvaStorico" class="form-check-input" type="checkbox">
                                    <span class="form-check-label">Salva in storico</span>
                                </label>

                                @if (this.Model.IsPrevistoCopyToPath)
                                {
                                    <label class="form-check">
                                        <input id="chkEseguiCopiaPath" class="form-check-input" type="checkbox">
                                        <span class="form-check-label">Copia su path previsto</span>
                                    </label>
                                }

                                @if (this.Model.IsPrevistoInvioMail)
                                {
                                    <label class="form-check">
                                        <input id="chkEseguiInviaEmail" class="form-check-input" type="checkbox">
                                        <span class="form-check-label">Invia e-mail</span>
                                    </label>
                                }

                            </div>
                        </div>
                        
                        <div class="mt-4">
                            <label class="form-check">
                                <input id="radEseguiSoloQuery" class="form-check-input" type="radio" name="radios">
                                <span class="form-check-label">Esegui query semplice</span>
                            </label>
                        </div>
                    </div>

                </div>
          
                <div class="download d-none">
                    aaaaa
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn me-auto" data-bs-dismiss="modal">Close</button>
                <button id="btnReshow" type="button" class="btn btn-success d-none">Riapri Tabella</button>
                <button id="btnEsegui" type="button" class="btn btn-primary">Esegui</button>

            </div>

        </div>
    </div>

    <script>

            $(function(){
                $("#btnEsegui").setDisabled(true);

                $("#modal-esegui input[type='radio']").on("change", function(){
                        $("#modal-esegui input[type='checkbox']").prop("disabled", $("#radEseguiScarica:checked").length == 0);
                        $("#btnEsegui").setDisabled(false);
                }).first().change();

                $("#btnEsegui").on("click", function(){
                    if ($("#radEseguiSoloQuery").is(":checked"))
                    {
                        eseguiTable();
                    }
                    else
                    {
                      eseguiFile();
                    }
                });

                $("#btnReshow").on("click", function(){
                    $("#modal-result-table").modal("show");
                });

            });

            function eseguiTable() {
               $("#btnEsegui").setDisabled(true).html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> In corso..');
               ajaxGetAsync("?handler=EseguiTable&id=@Model.DataObj.Id", null, function(data){
                    $("#modal-result-table").remove();
                    //console.log(data);
                    $("body").append(data);
                    $("#modal-result-table").modal("show");
                    $("#btnEsegui").html("Esegui").setDisabled(false); 
                    $("#btnReshow").removeClass("d-none");

                 }, null, 'none');
            }

            function eseguiFile() {

               $("#btnEsegui").setDisabled(true).html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> In corso..');
               ajaxGetAsync("?handler=EseguiFile&id=@Model.DataObj.Id&invia=false&copia=false", null, function(data){
                    $("#modal-result-table").remove();
                    $("#btnEsegui").html("Esegui").setDisabled(false);
                    $("#btnReshow").addClass("d-none");
                    console.log(data);
                    $("div.download").removeClass("d-none").html(data.nomeFile);
                 }, null, 'none');

            }

    </script>

</div>

