@page "{Id:int?}"
@model AddOrEdit
@{
    ViewData["Title"] = "Gestione Estrazione";
}


<div class="container-xl py-4">

    @* ── Header pagina ── *@
    <div class="d-flex align-items-center gap-3 mb-4">
        <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm">
            <i class="fa-solid fa-arrow-left"></i>
        </a>
        <div>
            <h4 class="mb-0 fw-semibold">
                <i class="fa-solid fa-file-export text-primary me-2"></i>@Model.Input?.Nome
            </h4>
            @if (Model.IsEdit)
            {
                <small class="text-muted">ID: @Model.Input?.Id</small>
            }
        </div>
        <div class="ms-auto">
            <button type="button" id="btn-save" class="btn btn-primary px-4">
                <i class="fa-solid fa-floppy-disk me-2"></i>Salva
            </button>
        </div>
    </div>

    @* ── Alert feedback AJAX ── *@
    <div id="ajax-alert" class="alert d-none mb-3" role="alert"></div>

    @* ── Antiforgery token (letto da jQuery) ── *@
    @Html.AntiForgeryToken()

    <div class="row g-4">

        @* ╔══════════════════════════════════╗
           ║  COLONNA SINISTRA                ║
           ╚══════════════════════════════════╝ *@
        <div class="col-lg-7">

            @* Card: Anagrafica *@
            <div class="card border shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-semibold text-secondary">
                        <i class="fa-solid fa-circle-info me-2"></i>Anagrafica
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">

                        @* Nome *@
                        <div class="col-12">
                            <label class="form-label fw-medium" for="Nome">
                                Nome <span class="text-danger">*</span>
                            </label>
                            <input type="text" id="Nome" class="form-control"
                                   value="@Model.Input.Nome" maxlength="100"
                                   placeholder="Nome univoco dell'estrazione" />
                            <div class="invalid-feedback" id="err-Nome"></div>
                        </div>

                        @* Titolo *@
                        <div class="col-12">
                            <label class="form-label fw-medium" for="Titolo">Titolo</label>
                            <input type="text" id="Titolo" class="form-control"
                                   value="@Model.Input.Titolo"
                                   placeholder="Titolo leggibile (opzionale)" />
                        </div>

                        @* Gruppo + Attivo *@
                        <div class="col-md-7">
                            <label class="form-label fw-medium" for="Gruppo">Gruppo</label>
                            <input type="text" id="Gruppo" class="form-control"
                                   value="@Model.Input.Gruppo"
                                   placeholder="Categoria / gruppo" />
                        </div>
                        <div class="col-md-5 d-flex align-items-end pb-1">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox"
                                       role="switch" id="Attivo"
                                       @(Model.Input.Attivo ? "checked" : "") />
                                <label class="form-check-label fw-medium" for="Attivo">Attivo</label>
                            </div>
                        </div>

                        @* Note *@
                        <div class="col-12">
                            <label class="form-label fw-medium" for="Note">Note</label>
                            <textarea id="Note" class="form-control" rows="3"
                                      placeholder="Note libere…">@Model.Input.Note</textarea>
                        </div>

                    </div>
                </div>
            </div>

            @* Card: SQL *@
            <div class="card border shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-semibold text-secondary">
                        <i class="fa-solid fa-code me-2"></i>Query SQL
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">

                        <div class="col-12">
                            <label class="form-label fw-medium" for="SqlText">
                                Testo SQL <span class="text-danger">*</span>
                            </label>
                            <textarea id="SqlText" class="form-control font-monospace"
                                      rows="9" style="font-size:.85rem"
                                      placeholder="SELECT …">@Model.Input.SqlText</textarea>
                            <div class="invalid-feedback" id="err-SqlText"></div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-medium" for="SheetName">
                                Nome foglio (Excel)
                            </label>
                            <input type="text" id="SheetName" class="form-control"
                                   value="@Model.Input.SheetName" placeholder="Sheet1" />
                        </div>

                    </div>
                </div>
            </div>

            @* Card: Output *@
            <div class="card border shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-semibold text-secondary">
                        <i class="fa-solid fa-folder-open me-2"></i>Output
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">

                        <div class="col-md-8">
                            <label class="form-label fw-medium" for="NomeFileMask">
                                Maschera nome file
                            </label>
                            <input type="text" id="NomeFileMask" class="form-control"
                                   value="@Model.Input.NomeFileMask" maxlength="150"
                                   placeholder="es. report_{data}.xlsx" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-medium" for="NumOutputStorico">
                                Output in storico
                            </label>
                            <input type="number" id="NumOutputStorico" class="form-control"
                                   value="@Model.Input.NumOutputStorico" min="1" max="999" />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-medium" for="CopyToPath">
                                Copia su percorso
                            </label>
                            <input type="text" id="CopyToPath" class="form-control"
                                   value="@Model.Input.CopyToPath"
                                   placeholder="\\server\share\cartella" />
                        </div>

                        <div class="col-md-8">
                            <label class="form-label fw-medium" for="EstrazioniAccorpateIds">
                                IDs estrazioni da accorpare
                            </label>
                            <input type="text" id="EstrazioniAccorpateIds" class="form-control"
                                   value="@Model.Input.EstrazioniAccorpateIds"
                                   placeholder="es. 3,7,12" />
                        </div>

                        <div class="col-md-4 d-flex align-items-end pb-1">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox"
                                       role="switch" id="AccorpaSoloDati"
                                       @(Model.Input.AccorpaSoloDati ? "checked" : "") />
                                <label class="form-check-label fw-medium" for="AccorpaSoloDati">
                                    Accorpa solo dati
                                </label>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

        </div>@* /col-lg-7 *@


        @* ╔══════════════════════════════════╗
           ║  COLONNA DESTRA                  ║
           ╚══════════════════════════════════╝ *@
        <div class="col-lg-5">

            @* Card: Configurazione *@
            <div class="card border shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-semibold text-secondary">
                        <i class="fa-solid fa-sliders me-2"></i>Configurazione
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">

                        @* Connessione *@
                        <div class="col-12">
                            <label class="form-label fw-medium" for="ConnessioneId">
                                Connessione <span class="text-danger">*</span>
                            </label>
                            <select id="ConnessioneId" class="form-select">
                                @foreach (var item in Model.Connessioni)
                                {
                                    <option value="@item.Value" selected="@(item.Value == Model.Input.ConnessioneId.ToString())">@item.Text</option>
                                }
                            </select>
                            <div class="invalid-feedback" id="err-ConnessioneId"></div>
                        </div>

                        @* Tipo File *@
                        <div class="col-12">
                            <label class="form-label fw-medium" for="TipoFileId">
                                Tipo file <span class="text-danger">*</span>
                            </label>
                            <select id="TipoFileId" class="form-select">
                                @foreach (var item in Model.TipiFile)
                                {
                                    <option value="@item.Value" selected="@(item.Value == Model.Input.ConnessioneId.ToString())">@item.Text</option>
                                }
                            </select>
                            <div class="invalid-feedback" id="err-TipoFileId"></div>
                        </div>

                        @* Template *@
                        <div class="col-12">
                            <label class="form-label fw-medium" for="TemplateId">Template</label>
                            <select id="TemplateId" class="form-select">
                                <option value="">(nessuno)</option>
                                @foreach (var item in Model.Templates)
                                {
                                    <option value="@item.Value" selected="@(item.Value == Model.Input.ConnessioneId.ToString())">@item.Text</option>
                                }
                            </select>
                        </div>

                        @* InvioMailAttivo *@
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox"
                                       role="switch" id="InvioMailAttivo"
                                       @(Model.Input.InvioMailAttivo ? "checked" : "") />
                                <label class="form-check-label fw-medium" for="InvioMailAttivo">
                                    <i class="fa-solid fa-envelope me-1 text-secondary"></i>
                                    Invio mail attivo
                                </label>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            @* Card: Schedulazione *@
            <div class="card border shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-semibold text-secondary">
                        <i class="fa-solid fa-clock me-2"></i>Schedulazione
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">

                        <div class="col-12">
                            <label class="form-label fw-medium" for="CronString">
                                Stringa CRON <span class="text-danger">*</span>
                            </label>
                            <input type="text" id="CronString" class="form-control font-monospace"
                                   value="@Model.Input.CronString" placeholder="0 8 * * 1-5" />
                            <div class="form-text">
                                <i class="fa-solid fa-circle-question me-1"></i>
                                Formato: minuto ora giorno mese giorno-settimana
                            </div>
                            <div class="invalid-feedback" id="err-CronString"></div>
                        </div>

                        <div class="col-6">
                            <label class="form-label fw-medium" for="DataInizio">
                                Data inizio <span class="text-danger">*</span>
                            </label>
                            <input type="date" id="DataInizio" class="form-control"
                                   value="@Model.Input.DataInizio.ToString("yyyy-MM-dd")" />
                            <div class="invalid-feedback" id="err-DataInizio"></div>
                        </div>

                        <div class="col-6">
                            <label class="form-label fw-medium" for="DataFine">
                                Data fine <span class="text-danger">*</span>
                            </label>
                            <input type="date" id="DataFine" class="form-control"
                                   value="@Model.Input.DataFine.ToString("yyyy-MM-dd")" />
                            <div class="invalid-feedback" id="err-DataFine"></div>
                        </div>

                    </div>
                </div>
            </div>

            @* Card: Info record (solo modifica) *@
            @if (Model.IsEdit)
            {
                <div class="card border shadow-sm">
                    <div class="card-header bg-white py-3">
                        <h6 class="mb-0 fw-semibold text-secondary">
                            <i class="fa-solid fa-tag me-2"></i>Informazioni record
                        </h6>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0 small text-muted">
                            <dt class="col-5">ID</dt>
                            <dd class="col-7 mb-1">@Model.Input.Id</dd>
                        </dl>
                    </div>
                </div>
            }

        </div>@* /col-lg-5 *@

    </div>@* /row *@
</div>@* /container *@


@section Scripts {
<script>
$(function () {

    // ── Token antiforgery (richiesto dal PageModel) ───────────────────────
    const token = $('input[name="__RequestVerificationToken"]').val();

    // ── URL dell'handler Save ─────────────────────────────────────────────
    // Razor Pages: stessa pagina + ?handler=Save
    const saveUrl = window.location.pathname + '?handler=Save';

    // ── Raccoglie tutti i valori del form ─────────────────────────────────
    function raccogliDati() {
        var d = {
            Id:                     @Model.Input.Id,
            Nome:                   $('#Nome').val().trim(),
            Attivo:                 $('#Attivo').is(':checked'),
            Titolo:                 $('#Titolo').val().trim() || null,
            Gruppo:                 $('#Gruppo').val().trim() || null,
            Note:                   $('#Note').val().trim()   || null,
            ConnessioneId:          parseInt($('#ConnessioneId').val()) || 0,
            TipoFileId:             parseInt($('#TipoFileId').val())    || 0,
            TemplateId:             parseInt($('#TemplateId').val())    || null,
            InvioMailAttivo:        $('#InvioMailAttivo').is(':checked'),
            SqlText:                $('#SqlText').val().trim(),
            SheetName:              $('#SheetName').val().trim()              || null,
            CronString:             $('#CronString').val().trim(),
            DataInizio:             $('#DataInizio').val(),
            DataFine:               $('#DataFine').val(),
            NumOutputStorico:       parseInt($('#NumOutputStorico').val())    || 20,
            EstrazioniAccorpateIds: $('#EstrazioniAccorpateIds').val().trim() || null,
            AccorpaSoloDati:        $('#AccorpaSoloDati').is(':checked'),
            CopyToPath:             $('#CopyToPath').val().trim()             || null,
            NomeFileMask:           $('#NomeFileMask').val().trim()           || null
        };

        console.log(d);
        return d;
    }

    // ── Mostra alert ──────────────────────────────────────────────────────
    function mostraAlert(tipo, messaggio) {
        $('#ajax-alert')
            .removeClass('d-none alert-success alert-danger')
            .addClass('alert-' + tipo)
            .html(messaggio);
        $('html, body').animate({ scrollTop: $('#ajax-alert').offset().top - 80 }, 250);
    }

    // ── Pulisce stato validazione ─────────────────────────────────────────
    function resetValidation() {
        $('.form-control, .form-select').removeClass('is-invalid');
        $('[id^="err-"]').text('');
    }

    // ── Evidenzia errori campo per campo ──────────────────────────────────
    function evidenziaErrori(errors) {
        if (!errors) return;
        $.each(errors, function (campo, msg) {
            $('#' + campo).addClass('is-invalid');
            $('#err-' + campo).text(msg);
        });
    }

    // ── Click Salva ───────────────────────────────────────────────────────
    $('#btn-save').on('click', function () {

        resetValidation();

        const $btn = $(this);
        $btn.prop('disabled', true)
            .html('<span class="spinner-border spinner-border-sm me-2" role="status"></span>Salvataggio…');

        $.ajax({
            url:         saveUrl,
            method:      'POST',
            contentType: 'application/json',
            headers:     { 'RequestVerificationToken': token },
            data:        JSON.stringify(raccogliDati()),

            success: function (res) {
                if (res.success) {
                    mostraAlert('success',
                        '<i class="fa-solid fa-circle-check me-2"></i>' + res.message);

                    // Dopo inserimento: aggiorna URL senza ricarica
                    if (@Model.Input.Id === 0 && res.id > 0) {
                        const nuovoUrl = window.location.pathname.replace(/\/+$/, '') + '/' + res.id;
                        window.history.replaceState(null, '', nuovoUrl);
                    }
                } else {
                    mostraAlert('danger',
                        '<i class="fa-solid fa-circle-xmark me-2"></i>' + res.message);
                    evidenziaErrori(res.errors);
                }
            },

            error: function (xhr) {
                const msgs = {
                    400: 'Richiesta non valida.',
                    401: 'Sessione scaduta. Effettua nuovamente il login.',
                    500: 'Errore interno del server.'
                };
                mostraAlert('danger',
                    '<i class="fa-solid fa-triangle-exclamation me-2"></i>' +
                    (msgs[xhr.status] || 'Errore di comunicazione.'));
            },

            complete: function () {
                $btn.prop('disabled', false)
                    .html('<i class="fa-solid fa-floppy-disk me-2"></i>Salva');
            }
        });
    });

});
</script>
}
